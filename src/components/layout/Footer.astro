---
import { siteConfig } from "../../config";
---

<footer class="border-t border-[var(--border)] mt-16">
  <div class="app-layout py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="col-span-2 md:col-span-1">
        <div class="text-lg font-bold gradient-text mb-3">{siteConfig.name}</div>
        <p class="text-sm text-[var(--text-tertiary)] leading-relaxed">{siteConfig.description}</p>
      </div>
      <div>
        <h4 class="text-xs font-semibold tracking-wide uppercase text-[var(--text-tertiary)] mb-4">Precious Metals</h4>
        <ul class="space-y-2">
          <li><a href="/gold" class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">🥇 Gold</a></li>
          <li><a href="/silver" class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">🥈 Silver</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-xs font-semibold tracking-wide uppercase text-[var(--text-tertiary)] mb-4">Energy</h4>
        <ul class="space-y-2">
          <li><a href="/oil" class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">🛢️ Oil</a></li>
          <li><a href="/gas" class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">🔥 Gas</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-xs font-semibold tracking-wide uppercase text-[var(--text-tertiary)] mb-4">More</h4>
        <ul class="space-y-2">
          <li><a href="/metals" class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">⛏️ Mining & Metals</a></li>
          <li><a href="/agriculture" class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">🌾 Agriculture</a></li>
          <li><a href="/trending" class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">Trending</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-[var(--border)] mt-10 pt-8 text-center text-xs text-[var(--text-tertiary)]">
      &copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
    </div>
  </div>
</footer>
